# ==============================================================================
# TrustNest Core Backend Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Google Gemini AI Integration (Required on Server Only)
# Get your API key from: https://aistudio.google.com/
# NEVER expose this key in client-side code, git commits, or browser requests.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Cross-Origin Resource Sharing (CORS) Configuration
# Comma-separated list of allowed frontend origins, or '*' for permissive access
# Local Development: http://localhost:5173
# Production Example: https://trustnest.vercel.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Atlas Database Configuration
# Provide standard MongoDB connection URI. Never commit real credentials.
# Atlas format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/trustnest?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/trustnest?retryWrites=true&w=majority
