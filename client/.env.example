# ==============================================================================
# TrustNest Client (Frontend) Environment Configuration
# ==============================================================================

# Backend API Base URL
#
# Development (default):
# Set to backend port 5000 if running server separately
VITE_API_URL=http://localhost:5000
#
# Production (Decoupled hosting, e.g. Vercel / Netlify frontend pointing to Render / Railway backend):
# VITE_API_URL=https://your-backend-api-subdomain.onrender.com
#
# Unified Full-Stack Hosting (Frontend served statically by the Express backend):
# Leave empty or set to empty string:
# VITE_API_URL=
